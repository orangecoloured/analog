{
  "name": "analog",
  "version": "0.1.6",
  "description": "A minimal analytics tool to self-host.",
  "main": "index.js",
  "scripts": {
    "build": "vite build",
    "dev": "concurrently 'vite --host' 'DEBUG=ioredis:* npx tsx watch --env-file=.env.local src/services/server/index.ts'",
    "prepare": "husky install"
  },
  "keywords": [],
  "author": "RCKT",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "concurrently": "10.0.4",
    "eslint": "10.8.1",
    "globals": "17.9.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@netlify/functions": "5.3.0",
    "@netlify/vite-plugin": "2.12.9",
    "@vercel/node": "5.9.7",
    "ioredis": "6.0.0",
    "mongodb": "7.5.0",
    "pg": "8.23.0",
    "toad-scheduler": "4.1.0",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "uuid": "14.0.1"
  },
  "engines": {
    "node": ">=22.x"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ],
    "*.{html,css}": [
      "prettier --write",
      "git add"
    ]
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.27.0": true,
    "esbuild@0.28.0": true,
    "sharp@0.34.5": true
  }
}
